+<!DOCTYPE html>
+<html class="light" lang="en" xmlns:th="http://www.thymeleaf.org" xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout" layout:decorate="~{layouts/app}">
+<head>
+    <title>Insurance &amp; Compliance | JustJava FAMS</title>
+</head>
+<body>
+<main id="main-content" class="space-y-6 px-4 sm:px-6 lg:px-8" layout:fragment="content">
+    <nav class="flex items-center gap-2 text-secondary font-label-small text-label-small">
+        <a class="hover:text-primary transition-colors" th:href="@{/reports}">Reports</a>
+        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
+        <span class="text-on-surface font-medium">Insurance &amp; Compliance</span>
+    </nav>
+
+    <div th:if="${successMessage}" class="bg-status-success/10 border border-status-success/30 text-status-success rounded-lg px-4 py-3 text-body-default" th:text="${successMessage}"></div>
+    <div th:if="${errorMessage}" class="bg-status-error/10 border border-status-error/30 text-status-error rounded-lg px-4 py-3 text-body-default" th:text="${errorMessage}"></div>
+
+    <section class="bg-surface-card border border-border-default rounded-xl overflow-hidden card-shadow">
+        <div class="p-5 border-b border-border-default">
+            <h3 class="font-card-header text-card-header text-on-surface">Category requirements</h3>
+            <p class="text-body-default text-secondary mt-1">Mark the categories whose assets should be insured or certified. The Uninsured Assets and Compliance reports use these.</p>
+        </div>
+        <div class="overflow-x-auto p-5"><table class="w-full text-left border-collapse">
+<thead><tr class="border-b border-border-default"><th class="py-2 pr-4 text-label-small text-secondary uppercase tracking-wider">Category</th><th class="py-2 pr-4 text-label-small text-secondary uppercase tracking-wider">Insurance expected</th><th class="py-2 pr-4 text-label-small text-secondary uppercase tracking-wider">Certification expected</th><th></th></tr></thead>
+<tbody class="divide-y divide-border-default">
+<tr th:each="c : ${categories}">
+  <td class="py-2 pr-4 text-body-default text-on-surface" th:text="${c.name}">Category</td>
+  <td colspan="3" class="py-2">
+    <form th:action="@{/insurance/categories/{id}(id=${c.id})}" method="post" class="flex items-center gap-6">
+      <label class="flex items-center gap-2 text-body-default text-on-surface"><input type="checkbox" name="insuranceRequired" value="true" th:checked="${c.insuranceRequired}"> Insured</label>
+      <label class="flex items-center gap-2 text-body-default text-on-surface"><input type="checkbox" name="certificationRequired" value="true" th:checked="${c.certificationRequired}"> Certified</label>
+      <button type="submit" class="px-3 py-1 border border-border-default rounded-lg text-label-small text-primary hover:bg-surface-canvas transition-colors">Save</button>
+    </form>
+  </td>
+</tr>
+</tbody></table></div>
